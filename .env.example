# LedgerCore Environment Configuration

APP_NAME=LedgerCore
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# PostgreSQL Connection Strings
DATABASE_URL=postgresql://localhost:5432/ledgercore
TEST_DATABASE_URL=postgresql://localhost:5432/ledgercore_test

# Database Connection Pool Settings
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=30
DB_COMMAND_TIMEOUT_SEC=15.0

# Idempotency Cache TTL
IDEMPOTENCY_CACHE_TTL_DAYS=30
